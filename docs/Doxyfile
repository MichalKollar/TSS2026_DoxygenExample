# ============================================================
#  Doxygen konfiguračný súbor
#  Portable verzia Doxygen a Graphviz (funguje bez inštalácie, len s rozbalenými ZIP súbormi)
# ============================================================


# --- ZÁKLADNÉ INFORMÁCIE O PROJEKTE --------------------------

# Názov projektu – zobrazí sa na titulnej stránke dokumentácie
PROJECT_NAME           = "DoxygenExample"

# Kam sa uloží vygenerovaný výstup (relatívne k tomuto súboru)
# Odporúčanie: používať podpriečinok „out“, aby sa repozitár nezaplnil HTML súbormi
OUTPUT_DIRECTORY       = ./out

# Generovanie HTML dokumentácie (hlavný formát)
GENERATE_HTML          = YES

# Generovanie LaTeX (PDF) – vypnuté, aby sa zbytočne negenerovali stovky súborov
GENERATE_LATEX         = NO



# --- ZDROJOVÉ SÚBORY -----------------------------------------

# Kde sa nachádzajú zdrojové súbory projektu (v našej štruktúre sú v ../src)
INPUT                  = ../src

# Ktoré prípony súborov sa majú spracovať
# Qt projekty často používajú .h, .cpp a .ui
FILE_PATTERNS          = *.h *.cpp *.ui 

# Ak má projekt podpriečinky, prechádza ich rekurzívne
RECURSIVE              = YES



# --- EXTRAKCIA INFORMÁCIÍ Z KÓDU ------------------------------

# Ak je YES, Doxygen zdokumentuje všetko – aj bez komentárov
# Pre výučbu nechávame NO, aby bolo vidno, ktoré časti ešte chýbajú
 EXTRACT_ALL            = YES
#EXTRACT_ALL            = NO

# Dokumentovať aj private členov tried (napr. privátne premenné)? Väčšinou nie.
EXTRACT_PRIVATE        = NO

# Dokumentovať aj statické (static) metódy – áno, tie sú často dôležité
EXTRACT_STATIC         = YES

# Dokumentovať aj metódy vnorených tried a štruktúr
EXTRACT_LOCAL_METHODS  = YES

# Automaticky interpretovať prvý riadok komentára ako @brief
# Vďaka tomu stačí napísať /** Trieda pre úpravu fotiek. */
JAVADOC_AUTOBRIEF      = YES

# Umožní používať aj Qt štýl komentárov (/// alebo //!)
QT_AUTOBRIEF           = YES

# Varovania, ak niečo nie je zdokumentované
WARN_IF_UNDOCUMENTED   = YES

# Varovania, ak je v komentári chyba (napr. @param bez názvu)
WARN_IF_DOC_ERROR      = YES



# --- DIAGRAMY (GRAPHVIZ) -------------------------------------

# Aktivuje generovanie UML diagramov a vzťahov
HAVE_DOT               = YES

# Cesta ku Graphviz (portable verzia: tools/graphviz)
DOT_PATH               = ../tools/graphviz

# Použije UML-štýl symbolov (namiesto jednoduchých boxov)
UML_LOOK               = YES

# Zahrnie aj atribúty a metódy v diagramoch.
DOT_UML_DETAILS        = YES

# Formát obrázkov v HTML – SVG je najkvalitnejší (zoomovateľný)
DOT_IMAGE_FORMAT       = svg

# Generovať grafy volaní funkcií (môže byť pomalé)
CALL_GRAPH             = NO

# Generovať grafy, kto volá danú funkciu (tiež spomaľuje)
CALLER_GRAPH           = NO


# --- ZOBRAZENIE KÓDU A FORMÁTOVANIE ---------------------------

# Pridať sekciu „Source“ v HTML – umožní zobraziť kód s preklikmi
SOURCE_BROWSER         = YES

# Zobrazovať kód priamo pod popisom metódy (neodporúčané pre väčšie projekty)
INLINE_SOURCES         = NO

# Odstrániť komentáre z ukážok kódu – NIE, chceme ich zachovať
STRIP_CODE_COMMENTS    = NO

#Aby sa v HTML nezobrazovali dlhé absolútne cesty:
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = ../

# --- ĎALŠIE MOŽNOSTI (na doplnenie podľa potreby) -------------

# Do dokumentacie možeme pridávať naše obrázky
IMAGE_PATH = ../docs/images

# Generovať interaktívne rozbaľovacie menu v HTML
GENERATE_TREEVIEW      = YES

# Jazyk výstupu – mení nadpisy sekcií (Class, File → Trieda, Súbor)
# OUTPUT_LANGUAGE        = Slovak

# Pridanie loga na titulnú stránku
# PROJECT_LOGO           = ../docs/logo.png

# Použiť README.md ako hlavnú stránku (alternatíva k @mainpage)
# USE_MDFILE_AS_MAINPAGE = ../README.md


# --- KONIEC SÚBORU --------------------------------------------
# Na spustenie dokumentácie:
#   cd docs
#   ..\tools\doxygen\doxygen.exe Doxyfile
#
# Výsledok sa uloží do:
#   docs/out/html/index.html
#
# Pre Git:
#   odporúča sa pridať do .gitignore:
#   docs/out/
# ============================================================

